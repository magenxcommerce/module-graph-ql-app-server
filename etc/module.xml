<?xml version="1.0"?>
<!--
  PoC GraphQL application server: runs /graphql inside a FrankenPHP worker
  with the application kept in memory. No schema or config of its own;
  registered as a module so the core Resetter picks up etc/reset.json shipped
  here (or in any other module), and for the graphql-area plugin that
  repairs state the reset cannot (etc/graphql/di.xml). See README.md.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magenx_AppServer">
        <sequence>
            <module name="Magento_GraphQl"/>
        </sequence>
    </module>
</config>
