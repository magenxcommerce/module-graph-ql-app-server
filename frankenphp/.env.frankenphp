
## ---------------------------------------------------------------------------------------------------------------------
## FrankenPHP GraphQL worker (append to .env)
## ---------------------------------------------------------------------------------------------------------------------
## Builder: official FrankenPHP image (ZTS PHP). Keep the PHP minor in line with PHP_VERSION.
## frankenphp v1.13.0, php 8.4.26, debian 13
FRANKENPHP_IMAGE="dunglas/frankenphp:1-php8.4-trixie@sha256:2fd4a848c05bf4902a3d9ff1a4991c2f4d4665df0567aee21be4eee120ded038"
## Runtime: Docker Hardened Debian 13 (no shell, no package manager, nonroot 65532). Pin by digest like the rest.
FRANKENPHP_RUNTIME_IMAGE="dhi.io/debian:13"
## Same set as PHP_EXTENSION, plus what the DHI php image has built in.
FRANKENPHP_EXTENSION="gd xsl zip bcmath ftp pdo_mysql soap sockets intl opcache"
FRANKENPHP_PORT="8081"
## Read-only Prometheus /metrics for other containers (http://frankenphp:2020/metrics).
## The Caddy admin API itself stays on 127.0.0.1:2019 inside the container.
FRANKENPHP_METRICS_PORT="2020"
FRANKENPHP_MEM_LIMIT="4G"

## Threads: GRAPHQL_WORKERS booted Magento instances (~150-300 MB each), GRAPHQL_MAX_THREADS >= GRAPHQL_WORKERS.
GRAPHQL_WORKERS="8"
GRAPHQL_MAX_THREADS="16"
## Idle time after which a thread added above GRAPHQL_WORKERS is stopped again (FrankenPHP default 5s).
GRAPHQL_MAX_IDLE_TIME="60s"
## Worker script, relative to the release root (app/code install: app/code/Magenx/AppServer/bin/graphql-worker.php).
GRAPHQL_WORKER_FILE="vendor/magenxcommerce/module-graph-ql-app-server/bin/graphql-worker.php"

## Recycling: a worker exits cleanly after N requests, above this memory, or after this many seconds
## (bounds how long an admin config change can go unseen).
MAGENX_WORKER_MAX_REQUESTS="500"
MAGENX_WORKER_MAX_MEMORY_MB="512"
MAGENX_WORKER_MAX_AGE="300"
## Empty: default allowlist of anonymous read-only root fields (Worker/ReadOnlyScope.php).
MAGENX_WORKER_ALLOWED_FIELDS=""
