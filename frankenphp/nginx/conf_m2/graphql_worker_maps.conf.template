## FrankenPHP GraphQL worker: upstream and routing maps (http context).
## Include right after conf_m2/maps.conf in sites-available/magento2.conf.

upstream frankenphp {
    ## `resolve` (nginx >= 1.27.3) looks the container up through the stack's
    ## resolver at runtime: nginx starts even when the frankenphp container is
    ## stopped or not created yet; /graphql then falls back to php-fpm (502).
    zone frankenphp 64k;
    ## max_fails=0: the worker answers out-of-scope requests with 503 on
    ## purpose; that is a routing answer, not a fault, and must never take
    ## the worker out of rotation.
    server frankenphp:8081 resolve max_fails=0;
    keepalive 32;
}

## Canary share of /graphql traffic sent to the worker. Raise step by step
## once graphql-timing and error logs look clean. Customer-token requests go
## to the worker too: in restricted mode it refuses them before Magento runs
## (well under 1 ms), and nginx replays them on php-fpm.
split_clients "${http_x_forwarded_for}${http_user_agent}" $graphql_worker_route {
    10%   worker;
    *     fpm;
}

## Whether a worker error (502/503/504) may be replayed on php-fpm. Only when
## the worker cannot have run the request:
##  - nothing was sent to it ($upstream_bytes_sent 0: connection refused or
##    timed out, container stopped);
##  - it refused before Magento ran (X-Magenx-Worker: out-of-scope or
##    maintenance);
##  - GET: Magento runs no mutation over GET, so a replay is a second read.
## Otherwise (a POST that reached the worker and failed half-way) a replay
## could run a mutation twice, e.g. place an order twice.
map "$request_method:$upstream_bytes_sent:$upstream_http_x_magenx_worker" $graphql_worker_replay {
    default                 "";
    "~^GET:"                1;
    "~^[A-Z]+:0:"           1;
    "~:out-of-scope$"       1;
    "~:maintenance$"        1;
}
