## FrankenPHP GraphQL worker: /graphql routing (server context).
## Include in sites-available/magento2.conf before `location /`.
##
## The same config serves both worker modes (MAGENX_WORKER_MODE): the worker
## itself refuses what its mode does not serve. php-fpm stays the fallback:
## requests routed to fpm, and anything replayed (see $graphql_worker_replay
## in graphql_worker_maps.conf) are internally rewritten to /index.php,
## exactly what `location /` + try_files does today. REQUEST_URI stays
## /graphql and the buffered request body is replayed as is.

location = /graphql {
    if ($graphql_worker_route = fpm) {
        rewrite ^ /index.php last;
    }

    proxy_pass http://frankenphp;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    ## Client IP after real_ip, adopted by the worker as REMOTE_ADDR
    ## (MAGENX_WORKER_TRUST_X_REAL_IP=1). X-Forwarded-Proto from varnish
    ## passes through unchanged, as it does to php-fpm.
    proxy_set_header X-Real-IP $remote_addr;

    ## Connecting inside the docker network takes well under 1 ms; keep this
    ## short so a stopped worker (stale DNS for up to `valid=30s`) costs
    ## little before the php-fpm fallback.
    proxy_connect_timeout 300ms;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    proxy_intercept_errors on;
    error_page 502 = @graphql_worker_502;
    error_page 503 = @graphql_worker_503;
    error_page 504 = @graphql_worker_504;
}

## A request the worker may already have run (a mutation, in default mode) is
## never replayed: it would run twice. The client gets the error instead.
location @graphql_worker_502 {
    if ($graphql_worker_replay) {
        rewrite ^ /index.php last;
    }
    return 502;
}

location @graphql_worker_503 {
    if ($graphql_worker_replay) {
        rewrite ^ /index.php last;
    }
    return 503;
}

location @graphql_worker_504 {
    if ($graphql_worker_replay) {
        rewrite ^ /index.php last;
    }
    return 504;
}
